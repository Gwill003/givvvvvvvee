function logout() {
    window.location.replace(GLOBAL_LANGUEAGE + '/login/logout');
}


function show_account_info() {
    $(".account_jt").toggleClass("acccoun_animate");
    var $obj = $(".myacc_page");
    if (NEED_FLUSH_BALANCE && !$obj.hasClass("open")) {
        flush_balance();
    }

    if ($obj.hasClass("open")) {
        ModalHelper.beforeClose();
        $(".myacc_page").slideToggle('100').toggleClass("open");
        $(".head .head_title").show();

    } else {

        $(".myacc_page").slideToggle('100').toggleClass("open");
        ModalHelper.afterOpen();
        $(".head .head_title").hide();
    }
};

function get_deposit_bonus() {
    $.post(GLOBAL_LANGUEAGE + '/Activity/GetDepositBonus', { "r": Math.random() }).done(function (result) {
        if (result.code == -1) {
            commonLogin(true);
        } else if (result.code == 1) {
            $("#div_alert_container").css("z-index", "1001");
            africaDialog.alert.okfunc = function () {
                $("#div_alert_container").css("z-index", "98");
                $(".cz_btn_state2,.ngcz_btn_state2").hide();
                if (result.data.status == 1 && result.data.next_bonus>0) {
                    $("span[data-name='nextBonus']").text(MONEY_FORMAT.format(result.data.next_bonus));
                    $(".cz_btn_state3,.ngcz_btn_state3").show();
                } else {
                    $(".cz_into_box").hide();
                }

                //window.location.reload();
            }
            africaDialog.alert.setTitle("tips").setContent(result.msg).show();
        } else {
            $("#div_alert_container").css("z-index", "1001");
            africaDialog.alert.okfunc = function () {
                $("#div_alert_container").css("z-index", "98");
            }
            africaDialog.alert.setTitle("Warning").setContent(result.msg).show();
        }
    });

}

function flush_balance() {
    $.ajax({
        url: GLOBAL_LANGUEAGE + '/membercenter/home/getBalance',
        type: "post",
        beforeSend: function () {
            africaDialog.loading.show();
        },
        success: function (data) {
            //var strBalance = GLOBAL_SHORT_CURRENCY + data.balance;
            //if (data.present != "0.00") {
            //    strBalance += "(" + GLOBAL_SHORT_CURRENCY + data.present + ")";
            //}
            $("#spBalance").text(data.balance);
            $("div[data-name='account_info_item']").text(MONEY_FORMAT.format(data.balance));
            $("span[data-name='withdrawBalance']").text(data.with_draw_enable);
            
            //if (data.freeze === "0.00") {
            //    $("div[data-name='sp_freeze_money']").html("");
            //} else {
                $("div[data-name='sp_freeze_money']").html("Frozen Money<span class=\"freezeMoney\">" + data.freeze + "</span>");
            //}

            //if (data.present === "0.00") {
            //    $("div[data-name='div_present']").html("");
            //} else {
                $("div[data-name='div_present']").html("Bonus Money<span class=\"freezeMoney\">" + data.present + "</span>");
            //}

            $("#bonusAmount").text(data.bonus);

            //if (data.withdrawFreeze === "0.00") {
            //    $("div[data-name='div_unwithdrawable']").html("");
            //} else {
                $("div[data-name='div_unwithdrawable']").html("Not Withdrawable<span class=\"freezeMoney\">" + data.withdrawFreeze + "</span>");
            //}
            var withdrawDiv = $("div[data-name='div_total_balance']");
            $("span[data-name='div_total_balance']").html(data.with_draw_enable);
            //$("div[data-name='sp_freeze_money']").text(data.freeze);
            //$("#spBalance").text(strBalance);
            //$("#spTotalBonus").text(GLOBAL_SHORT_CURRENCY + data.bonus);

            if (data.welcome_bonus.is_show) {
                var url = GLOBAL_LANGUEAGE + "/membercenter/deposit";
                $(".welcomeBonusContainer")
                    .html(
                        "<a href='' data-ajax='false' class='centerBanner'><img src='/images/v2/recharge/banner.png' alt=''></a>"
                        .format(url));
            }
            $("#dollar_balance").text(data.dollar_balance);
            if (data.welcome_bonus.bonus) {
                var html = [];
                var url = GLOBAL_LANGUEAGE + "/membercenter/Bonus/Available";
                html.push("<a href='{0}' data-ajax='false' class='welcomeBonus'>".format(url));
                html.push("    <div class=\"topcenter mb5\">");
                html.push("    <span class=\"boxflex c999\">100% Welcome Bonus</span>");
                html.push("    <span class=\"into\">");
                html.push("    <img src=\"/images/v2/lotto/go.png\">");
                html.push("    </span>");
                html.push("    </div>");
                html.push("    <div class=\"topcenter\">");
                html.push("    <span class=\"sfpFontBold font14 boxflex\">{0}</span>".format(data.welcome_bonus.bonus.amount));
                html.push("    </div>");
                html.push("    <div class=\"c999\">");
                html.push("    (Deadline:{0})".format(data.welcome_bonus.bonus.expired));
                html.push("</div></a>");

                $(".welcomeBonusContainer").html(html.join(""));
            }
        },
        complete: function () {
            africaDialog.loading.hide();
        }
    });
};


function reRenderHeaderHtml() {
